{
  "__inputs": [],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "11.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" }
  ],
  "annotations": { "list": [] },
  "description": "Spring Batch Bidirectional Sync - Operational Dashboard",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "Active Sync Jobs",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sync_jobs_active{application=\"sync-batch-data\"}",
          "legendFormat": "Active Jobs"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 3 },
              { "color": "red", "value": 10 }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "Job Success Rate (%)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "targets": [
        {
          "expr": "rate(sync_jobs_success_total[5m]) / (rate(sync_jobs_success_total[5m]) + rate(sync_jobs_failure_total[5m]) + 0.001) * 100",
          "legendFormat": "Success %"
        }
      ],
      "options": {
        "colorMode": "background",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 80 },
              { "color": "green", "value": 95 }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "Total Items Synced (last 1h)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "targets": [
        {
          "expr": "increase(sync_items_written_total[1h])",
          "legendFormat": "Items Written"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 4,
      "title": "Retry Count (last 1h)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "increase(sync_retry_count_total[1h])",
          "legendFormat": "Retries"
        }
      ],
      "options": {
        "colorMode": "background",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 20 }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "title": "Items Read/Written per Minute",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "expr": "rate(sync_items_read_total[1m]) * 60",
          "legendFormat": "Items Read/min"
        },
        {
          "expr": "rate(sync_items_written_total[1m]) * 60",
          "legendFormat": "Items Written/min"
        },
        {
          "expr": "rate(sync_items_skipped_total[1m]) * 60",
          "legendFormat": "Items Skipped/min"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" }
      }
    },
    {
      "id": 6,
      "title": "Read/Write Latency (p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(sync_read_duration_seconds_bucket[5m]))",
          "legendFormat": "p95 Read Latency"
        },
        {
          "expr": "histogram_quantile(0.95, rate(sync_write_duration_seconds_bucket[5m]))",
          "legendFormat": "p95 Write Latency"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" }
      }
    },
    {
      "id": 7,
      "title": "Job Executions - Success vs Failure",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        {
          "expr": "increase(sync_jobs_success_total[5m])",
          "legendFormat": "Success"
        },
        {
          "expr": "increase(sync_jobs_failure_total[5m])",
          "legendFormat": "Failure"
        }
      ]
    },
    {
      "id": 8,
      "title": "Circuit Breaker State",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        {
          "expr": "resilience4j_circuitbreaker_state{name=\"externalClient\"}",
          "legendFormat": "State (0=CLOSED, 1=OPEN, 2=HALF_OPEN)"
        }
      ]
    },
    {
      "id": 9,
      "title": "JVM Memory Usage",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{area=\"heap\"}",
          "legendFormat": "Heap Used"
        },
        {
          "expr": "jvm_memory_max_bytes{area=\"heap\"}",
          "legendFormat": "Heap Max"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "bytes" }
      }
    },
    {
      "id": 10,
      "title": "HTTP Request Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "targets": [
        {
          "expr": "rate(http_server_requests_seconds_count{uri=~\"/api/jobs/.*\"}[1m])",
          "legendFormat": "{{uri}} {{method}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps" }
      }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["spring-batch", "sync", "rabbitmq"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "title": "Sync Batch Data - Operations",
  "uid": "sync-batch-ops-v1",
  "version": 1
}
